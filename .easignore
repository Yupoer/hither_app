# EAS reads this file at the Git root and replaces all .gitignore rules.
# Keep local state, credentials, and native output exclusions here too.
.claude/
.worktrees/
.superpowers/
mcps/
node_modules/
npm-debug.log*
yarn-error.log*
.expo/
dist/
web-build/
*.log
coverage/
coverage-changed/
.env
.env.*
!.env.example
secrets/
**/service-account*.json
**/*-firebase-adminsdk-*.json
*.p8
google-services.json.local
.playwright-cli/
/apps/mobile/.qa-runtime/
/apps/mobile/.npm-cache-local/
/apps/mobile/android/
build-output/
test-artifacts/
*.xcuserstate
xcuserdata/
DerivedData/
build/
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
/supabase/.temp/

# Native project files stay in the archive; generated Xcode/Pods files do not.
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
*.xccheckout
*.moved-aside
*.hmap
*.ipa
project.xcworkspace
.xcode.env.local
*.jsbundle
/apps/mobile/ios/Pods/

# Development material is not needed to install dependencies or build the app.
/.github/
/scripts/
/supabase/
/apps/legal-site/
docs/
*.md
__tests__/
/apps/mobile/test/
/apps/mobile/scripts/
/apps/mobile/generate_report.js
/apps/mobile/jest.config*.js
/apps/mobile/jest.setup*.js
/apps/mobile/eslint.config.js
/apps/mobile/.eslintrc.js
