{
  "name": "@hither/mobile",
  "version": "0.1.0",
  "private": true,
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "main": "index.ts",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "expo start",
    "dev:client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:meta": "node scripts/check-test-meta.mjs",
    "test:coverage:changed": "node scripts/check-changed-coverage.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "postinstall": "patch-package",
    "verify:lock": "npm ci --include=dev --ignore-scripts",
    "verify:runtime": "node scripts/verify-runtime-alignment.mjs",
    "verify:ios-release-launch": "python3 scripts/verify-ios-release-launch.py",
    "update:preview": "eas update --channel preview",
    "update:production": "eas update --channel production"
  },
  "dependencies": {
