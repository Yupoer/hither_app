+  // A real Swift job establishes the executor context without moving the JS work.
+  @available(macOS 14.0, iOS 17.0, tvOS 17.0, watchOS 10.0, *)
+  @usableFromInline
+  internal static func runWithLegacyExecutor<T: ~Copyable>(_ operation: @JavaScriptActor () -> T) -> T {
+    let thread = Thread.current
+    let key = "ExpoModulesJSI.JavaScriptActor.legacyContext"
+    if thread.threadDictionary[key] as? Bool == true {
+      typealias IsolatedRunner = @JavaScriptActor (@JavaScriptActor () -> T) -> T
+      typealias NonisolatedRunner = (@JavaScriptActor () -> T) -> T
+      return unsafeBitCast(runIsolated as IsolatedRunner, to: NonisolatedRunner.self)(operation)
+    }
+    return withoutActuallyEscaping(operation) { body in
+      let capture = JavaScriptJobCapture()
+      let executor = JavaScriptExecutor(capture: capture, owner: thread)
+      let bridge = JavaScriptSynchronousActor(executor: executor)
+      let scope = JavaScriptSynchronousOperation(body)
+      // The worker only transfers a job to `capture`. It never reads/calls the JS closure.
+      // The task captures `scope`, whose operation is cleared by the caller-thread job
+      // before withoutActuallyEscaping exits (the task continuation may still be alive).
+      let task = Task {
+        await bridge.run { scope.run() }
+      }
+      capture.ready.wait()
