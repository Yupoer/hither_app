+      thread.threadDictionary[key] = true
+      job.runSynchronously(on: executor.asUnownedSerialExecutor())
+      thread.threadDictionary.removeObject(forKey: key)
+      withExtendedLifetime(task) {}
+      return scope.takeResult()
+    }
+  }
