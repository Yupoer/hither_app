+// Only `enqueue` writes the captured job; semaphore release/acquire publishes it
+// to the waiting JS thread. No JS values are inspected on the producer thread.
+private final class JavaScriptJobCapture: @unchecked Sendable {
+  var job: UnownedJob?
+  let ready = DispatchSemaphore(value: 0)
+}
+
+private actor JavaScriptSynchronousActor {
+  nonisolated let executor: JavaScriptExecutor
+  init(executor: JavaScriptExecutor) { self.executor = executor }
+  nonisolated var unownedExecutor: UnownedSerialExecutor { executor.asUnownedSerialExecutor() }
+  func run(_ operation: @Sendable () -> Void) { operation() }
+}
+
+private final class JavaScriptSynchronousOperation<T: ~Copyable>: @unchecked Sendable {
+  private var operation: (@JavaScriptActor () -> T)?
+  private var result: T?
+
+  init(_ operation: @escaping @JavaScriptActor () -> T) { self.operation = operation }
+
+  func run() {
+    // Taking clears the only escaping storage before invoking the nonescaping body.
+    let body = operation.take()!
+    typealias IsolatedRunner = @JavaScriptActor (@JavaScriptActor () -> T) -> T
+    typealias NonisolatedRunner = (@JavaScriptActor () -> T) -> T
+    let runner = unsafeBitCast(JavaScriptActor.runIsolated as IsolatedRunner, to: NonisolatedRunner.self)
+    result = runner(body)
+  }
+
+  func takeResult() -> T { result.take()! }
+}
