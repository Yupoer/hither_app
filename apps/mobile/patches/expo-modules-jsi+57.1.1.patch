+/// Executor for the `JavaScriptActor` that executes given jobs synchronously and immediately.
+/// - Note: It does not ensure that given jobs are executed on the JavaScript thread; it must be done externally.
+internal class JavaScriptExecutor: SerialExecutor, @unchecked Sendable {
+  private let capture: JavaScriptJobCapture?
+  private let owner: Thread?
+
+  fileprivate init(capture: JavaScriptJobCapture? = nil, owner: Thread? = nil) {
+    self.capture = capture
+    self.owner = owner
+  }
+
+  func enqueue(_ job: UnownedJob) {
+    if let capture {
+      capture.job = job
+      capture.ready.signal()
+    } else {
+      job.runSynchronously(on: self.asUnownedSerialExecutor())
+    }
+  }
+
+  func isSameExclusiveExecutionContext(other: JavaScriptExecutor) -> Bool {
+    if self === other { return true }
+    // Only base-class bridge/global executors may share a synchronous JS context.
+    // Runtime-specific subclasses must retain their distinct scheduler identity.
+    guard type(of: self) == JavaScriptExecutor.self,
+      type(of: other) == JavaScriptExecutor.self else { return false }
+    return (owner === Thread.current || other.owner === Thread.current) && JavaScriptActor.isJavaScriptContext
+  }
+
+  /// Converts the executor to the optimized form of borrowed executor reference.
+  func asUnownedSerialExecutor() -> UnownedSerialExecutor {
+    if #available(macOS 14.0, iOS 17.0, tvOS 17.0, watchOS 10.0, *) {
+      return UnownedSerialExecutor(complexEquality: self)
+    }
+    return UnownedSerialExecutor(ordinary: self)
+  }
+
+  /// Runtime hook used by Swift's actor data-race checks for synchronous entry into
+  /// `@JavaScriptActor` code. Do not remove: the `SerialExecutor` default always fails
+  /// when there is no active Swift task carrying this executor.
+  func checkIsolated() {
+    JavaScriptActor.checkIsolated()
+  }
+
+  @available(macOS 26.0, iOS 26.0, tvOS 26.0, watchOS 26.0, *)
+  func isIsolatingCurrentContext() -> Bool? {
+    JavaScriptActor.isJavaScriptContext
+  }
+}
+
+/// An actor that is dedicated for the specific runtime.
+internal actor JavaScriptRuntimeActor {
+  private weak let runtime: JavaScriptRuntime?
+  nonisolated private let executor: JavaScriptExecutor
+
+  init(runtime: JavaScriptRuntime) {
+    self.runtime = runtime
+    self.executor = JavaScriptRuntimeExecutor(runtime: runtime)
+  }
+
+  nonisolated var unownedExecutor: UnownedSerialExecutor {
+    return executor.asUnownedSerialExecutor()
+  }
+
+  func execute<R: Sendable>(_ operation: @escaping @JavaScriptActor () async throws -> R) async rethrows -> sending R {
+    return try await operation()
+  }
+}
+
+/// Serial executor dedicated for the specific runtime.
+internal final class JavaScriptRuntimeExecutor: JavaScriptExecutor, @unchecked Sendable {
+  private weak let runtime: JavaScriptRuntime?
+
+  init(runtime: JavaScriptRuntime) {
+    self.runtime = runtime
+  }
+
+  override func enqueue(_ job: UnownedJob) {
+    runtime?.schedule(priority: .immediate) {
+      job.runSynchronously(on: self.asUnownedSerialExecutor())
+    }
+  }
+}
+
+// Only `enqueue` writes the captured job; semaphore release/acquire publishes it
+// to the waiting JS thread. No JS values are inspected on the producer thread.
+private final class JavaScriptJobCapture: @unchecked Sendable {
+  var job: UnownedJob?
+  let ready = DispatchSemaphore(value: 0)
+}
+
+private actor JavaScriptSynchronousActor {
+  nonisolated let executor: JavaScriptExecutor
+  init(executor: JavaScriptExecutor) { self.executor = executor }
+  nonisolated var unownedExecutor: UnownedSerialExecutor { executor.asUnownedSerialExecutor() }
+  func run(_ operation: @Sendable () -> Void) { operation() }
+}
+
+private final class JavaScriptSynchronousOperation<T: ~Copyable>: @unchecked Sendable {
+  private var operation: (@JavaScriptActor () -> T)?
+  private var result: T?
+
+  init(_ operation: @escaping @JavaScriptActor () -> T) { self.operation = operation }
+
+  func run() {
+    // Taking clears the only escaping storage before invoking the nonescaping body.
+    let body = operation.take()!
+    typealias IsolatedRunner = @JavaScriptActor (@JavaScriptActor () -> T) -> T
+    typealias NonisolatedRunner = (@JavaScriptActor () -> T) -> T
+    let runner = unsafeBitCast(JavaScriptActor.runIsolated as IsolatedRunner, to: NonisolatedRunner.self)
+    result = runner(body)
+  }
+
+  func takeResult() -> T { result.take()! }
+}
