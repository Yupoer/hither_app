# Copy to apps/mobile/.env and fill locally. Never commit real secrets.

# Supabase (client)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# StoreKit auto-renewable subscription catalog. All three values are required;
# the client fails closed when any value is missing.
EXPO_PUBLIC_PREMIUM_MONTHLY_PRODUCT_ID=app.hither.premium.monthly
EXPO_PUBLIC_PREMIUM_ANNUAL_PRODUCT_ID=app.hither.premium.annual
EXPO_PUBLIC_PREMIUM_TRIP_PRODUCT_ID=hither.small_trip_pass
EXPO_PUBLIC_PREMIUM_SUBSCRIPTION_GROUP_ID=hither-premium

# Edge Function secrets (configure with Supabase secrets; never put values here):
# PREMIUM_TRIP_PRODUCT_ID=hither.small_trip_pass

# Google Maps SDK for Android (injected by app.config.ts into AndroidManifest)
GOOGLE_MAPS_ANDROID_API_KEY=

# Optional public Google Sign-In overrides. app.config.ts ships the current
# production client IDs and iOS URL scheme when these are left unset.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# GOOGLE_IOS_URL_SCHEME=

# Optional override for Firebase Android client config path
# GOOGLE_SERVICES_JSON=./google-services.json
